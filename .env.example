# ASRE — Environment Variables
# Copy to .env and fill in values before launching.
# NEVER commit .env to version control.

# -- Authentication -----------------------------------------------------------
# Comma-separated API keys. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ASRE_API_KEYS=your-secret-key-here,optional-second-key

# -- Supabase (used by scripts/noaa_free_pipeline.py + supabase_backup.py) -----
# Service key has full DB access — KEEP SECRET, never expose to the browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -- Database -----------------------------------------------------------------
# Local dev: path to Parquet sample (default used if unset)
ASRE_DATA_PATH=data/sample/year=*/month=*/part-0.parquet

# BigQuery (PRODUCTION DEMO ONLY — do not use in dev)
# ASRE_BQ_PROJECT=your-gcp-project-id
# ASRE_BQ_DATASET=noaa_isd
# ASRE_BQ_TABLE=observations
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# -- Connection Pool ----------------------------------------------------------
ASRE_DB_POOL_SIZE=8         # DuckDB connections in pool (match THREAD_WORKERS)

# -- Thread Pool --------------------------------------------------------------
ASRE_THREAD_WORKERS=16      # ThreadPoolExecutor workers for sync engine calls

# -- Cache --------------------------------------------------------------------
ASRE_CACHE_TTL_S=300        # Seconds a cached adjudication result is valid
ASRE_CACHE_MAX_SIZE=1024    # Max entries before oldest eviction

# -- Rate Limiting ------------------------------------------------------------
ASRE_RATE_LIMIT_PER_MIN=60  # Max requests per API key per 60-second window

# -- Request Handling ---------------------------------------------------------
ASRE_REQUEST_TIMEOUT_S=10.0  # Hard timeout on engine execution (504 on breach)
ASRE_MAX_CLAIM_LENGTH=2000   # Max characters in a claim payload

# -- Environment --------------------------------------------------------------
ASRE_ENV=production          # "development" | "production"
