# ── Supabase (get from supabase.com → Settings → API) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Admin write-gate (REQUIRED for production) ─────────────────────────────
# Shared secret required as a Bearer token on admin writes (customer create/
# update). The admin types this as their password on /login. Min 16 chars.
# Generate:  openssl rand -hex 24
ADMIN_API_SECRET=change-me-to-a-long-random-string

# ── Vercel Cron secret (keep-alive) ────────────────────────────────────────
# Vercel sends this as a Bearer token to /api/cron/keepalive. Set the SAME
# value in the Vercel project's Environment Variables. Generate as above.
CRON_SECRET=change-me-to-a-long-random-string

# ── Groq (get from console.groq.com — FREE) ────────────────────────────────
GROQ_API_KEY=gsk_...
# Optional: override the LLM model without a code redeploy if Groq retires the
# default. Any current Groq production model id works. Default: llama-3.1-8b-instant
# GROQ_MODEL=llama-3.1-8b-instant

# ── Sentry (error monitoring — sentry.io) ──────────────────────────────────
SENTRY_DSN=https://your-key@o123.ingest.sentry.io/456
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o123.ingest.sentry.io/456

# ── ASRE threshold overrides (optional — defaults are production values) ───
# See benchmarks/HISTORICAL_VALIDATION.md for sensitivity analysis.
# ASRE_GUST_FACTOR=1.0
# ASRE_WIND_THRESHOLD_MS=17.2
# ASRE_EXCEEDANCE_HOURS=3

# ── Local DuckDB Parquet path (for migration script only) ─────────────────
PARQUET_PATH=../data/noaa_isd/**/*.parquet
